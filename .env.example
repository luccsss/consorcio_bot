# Copia este archivo como ".env" y completa tus propios valores.
# NUNCA subas el archivo ".env" real a git ni lo compartas.

# Puerto donde correra el servidor local
PORT=3000

# Token de verificacion que TU inventas (cualquier string secreto).
# Debe coincidir exactamente con el que pongas en el panel de Meta
# al configurar el webhook (campo "Verify Token").
VERIFY_TOKEN=cambia_esto_por_un_secreto

# Datos de tu app de WhatsApp Business Cloud API (Meta for Developers):
# - PHONE_NUMBER_ID: en el panel de la API, seccion "WhatsApp > Introduccion"
# - WHATSAPP_TOKEN: token de acceso (temporal de prueba o permanente del
#   usuario del sistema). Mientras sea temporal, expira cada ~24h.
PHONE_NUMBER_ID=tu_phone_number_id
WHATSAPP_TOKEN=tu_token_de_acceso

# Token de acceso de tu Pagina de Facebook (vinculada a Messenger e
# Instagram). Se genera en el panel de la app, seccion "Messenger > Tokens
# de acceso de la pagina". El mismo token sirve para ambos canales.
PAGE_ACCESS_TOKEN=tu_token_de_pagina

# Version de la Graph API de Meta a usar
GRAPH_API_VERSION=v21.0

# URL publica donde corre este servidor (sin / al final). Se usa para
# construir enlaces a archivos que el bot envia (folletos, etc.).
# En local (con tunel) pon la URL del tunel; en Render, la de tu servicio.
BASE_URL=https://tu-servicio.onrender.com
